{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tutor Bot",
  "version": "0.1.0",
  "identifier": "com.studyapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tutor Bot",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWTKrYqkpwtcwlbV8cpWZ4vVDsjEmDr7ds7P+wwQ+CpQlKdIIeTsIWUc",
      "endpoints": [
        "https://github.com/carltonking/study-app/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}